"""Runs web searches for OC homeless services and drops raw leads into
resource_candidates. NOTHING here becomes user-visible until a human
approves it in the admin review queue.
"""
import logging
import re

from sqlalchemy.orm import Session

from app.clients.tools import web_search
from app.models.candidate import ResourceCandidate
from app.models.resource import Resource

logger = logging.getLogger(__name__)

SEARCH_TOPICS = [
    "emergency shelter Orange County CA",
    "transitional housing Orange County CA",
    "food pantry Orange County CA free",
    "free clinic Orange County CA uninsured",
    "domestic violence shelter Orange County CA",
    "youth homeless shelter Orange County CA",
    "veterans homeless services Orange County CA",
    "legal aid homeless Orange County CA",
    "benefits enrollment CalFresh Orange County CA",
    "shower laundry homeless Orange County CA",
    "mental health services low income Orange County CA",
    "substance use treatment Orange County CA low cost",
]

PHONE_RE = re.compile(r"\(?\d{3}\)?[-.\s]?\d{3}[-.\s]?\d{4}")


def _norm(s: str | None) -> str:
    return re.sub(r"\s+", "", (s or "").lower())


def _is_duplicate(db: Session, name: str, phone: str | None) -> bool:
    n = _norm(name)
    if db.query(Resource).filter(Resource.name.ilike(f"%{name[:80]}%")).first():
        return True
    if db.query(ResourceCandidate).filter(
        ResourceCandidate.status == "pending",
        ResourceCandidate.name.ilike(f"%{name[:80]}%"),
    ).first():
        return True
    if phone:
        digits = re.sub(r"\D", "", phone)[-10:]
        if digits and db.query(Resource).filter(Resource.phone.contains(digits)).first():
            return True
    return False


def run_growth_agent(db: Session, topics: list[str] | None = None) -> dict:
    added = skipped = errors = 0
    for topic in (topics or SEARCH_TOPICS):
        try:
            results = web_search(topic)
            if not results or "unavailable" in results.lower():
                continue
            # Naive extraction: each "- Title: ..." line becomes a candidate lead
            for line in results.split("\n"):
                line = line.strip("- ").strip()
                if len(line) < 20 or ":" not in line:
                    continue
                title = line.split(":")[0][:250]
                phone_m = PHONE_RE.search(line)
                phone = phone_m.group(0) if phone_m else None
                url_m = re.search(r"https?://\S+", line)
                url = url_m.group(0).rstrip(").,>") if url_m else None
                if _is_duplicate(db, title, phone):
                    skipped += 1
                    continue
                db.add(ResourceCandidate(
                    name=title,
                    description=line[:1000],
                    phone=phone,
                    url=url,
                    source_url=url,
                    status="pending",
                ))
                db.commit()
                added += 1
        except Exception as e:
            logger.warning(f"growth agent topic '{topic}' failed: {e}")
            db.rollback()
            errors += 1
    logger.info(f"growth agent: +{added} candidates, {skipped} dupes, {errors} errors")
    return {"added": added, "skipped": skipped, "errors": errors}