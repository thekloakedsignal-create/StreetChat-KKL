from datetime import datetime
from typing import Optional, List

from pydantic import BaseModel, Field


class TokenData(BaseModel):
    sub: int
    role: str
    exp: datetime
    iat: datetime


class RegisterRequest(BaseModel):
    username: str = Field(min_length=2, max_length=50)
    password: str = Field(min_length=4, max_length=128)
    recovery_question: str = Field(min_length=4, max_length=255)
    recovery_answer: str = Field(min_length=1, max_length=200)


class LoginRequest(BaseModel):
    username: str
    password: str


class RecoverStartRequest(BaseModel):
    username: str


class RecoverStartResponse(BaseModel):
    """Only returned when the account exists. Caller must behave
    identically either way to avoid username enumeration."""
    question: Optional[str] = None


class RecoverFinishRequest(BaseModel):
    username: str
    answer: str
    new_password: str = Field(min_length=4, max_length=128)


class TokenResponse(BaseModel):
    access_token: str
    token_type: str = "bearer"
    role: str


class ChatRequest(BaseModel):
    message: str = Field(min_length=1, max_length=4000)
    anonymous_id: Optional[str] = None


class ChatImageRequest(BaseModel):
    message: str = Field(default="What's in this image?", max_length=4000)
    image_base64: str
    media_type: str = "image/jpeg"
    anonymous_id: Optional[str] = None


class ResourceOut(BaseModel):
    id: int
    name: str
    description: Optional[str] = None
    address: Optional[str] = None
    city: Optional[str] = None
    phone: Optional[str] = None
    url: Optional[str] = None
    hours: Optional[str] = None
    eligibility: Optional[str] = None
    service_types: List[str] = []
    source_url: Optional[str] = None
    verified: bool

    class Config:
        from_attributes = True


class CandidateOut(BaseModel):
    id: int
    name: str
    description: Optional[str] = None
    address: Optional[str] = None
    city: Optional[str] = None
    phone: Optional[str] = None
    url: Optional[str] = None
    source_url: Optional[str] = None
    status: str
    reviewer_notes: Optional[str] = None
    found_at: datetime

    class Config:
        from_attributes = True


class ReviewRequest(BaseModel):
    notes: Optional[str] = None