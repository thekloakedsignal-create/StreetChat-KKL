from pydantic_settings import BaseSettings, SettingsConfigDict


class Settings(BaseSettings):
    model_config = SettingsConfigDict(env_file=".env", extra="ignore")

    # LLM — OpenAI-compatible endpoint (Featherless by default)
    featherless_api_key: str = ""
    featherless_base_url: str = "https://api.featherless.ai/v1"
    model_name: str = "RoseG/StreetChat-v1.36"

    # Database
    database_url: str = "postgresql://streetchat:devpassword@localhost:5432/streetchat"

    # Auth — change JWT_SECRET in production (render.yaml auto-generates it)
    jwt_secret: str = "dev-secret-change-me"
    jwt_algorithm: str = "HS256"
    jwt_expiry_minutes: int = 10080  # 7 days

    # Admin review queue header auth
    admin_api_key: str = ""

    # Growth agent web search
    tavily_api_key: str = ""

    # Twilio SMS channel
    twilio_account_sid: str = ""
    twilio_auth_token: str = ""
    twilio_phone_number: str = ""

    # Retrieval
    embeddings_enabled: bool = True
    risk_threshold: int = 70


settings = Settings()