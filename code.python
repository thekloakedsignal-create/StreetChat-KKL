"""Inbound MMS media needs HTTP Basic auth with account creds."""
import base64
import logging

import httpx

from app.config import settings

logger = logging.getLogger(__name__)


def fetch_media_base64(media_url: str) -> str | None:
    """Download a Twilio media attachment and return base64 content."""
    if not settings.twilio_account_sid or not settings.twilio_auth_token:
        logger.warning("Twilio creds unset — cannot fetch media")
        return None
    try:
        resp = httpx.get(
            media_url,
            auth=(settings.twilio_account_sid, settings.twilio_auth_token),
            timeout=30.0,
            follow_redirects=True,
        )
        resp.raise_for_status()
        return base64.b64encode(resp.content).decode()
    except Exception as e:
        logger.warning(f"media fetch failed: {e}")
        return None


def validate_signature(url: str, params: dict, signature: str) -> bool:
    """Verify X-Twilio-Signature. Always False if token unset (fail closed)."""
    if not settings.twilio_auth_token:
        return False
    from twilio.request_validator import RequestValidator
    return RequestValidator(settings.twilio_auth_token).validate(url, params, signature)