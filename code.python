from datetime import datetime, timezone

from sqlalchemy import Column, Integer, String, Boolean, DateTime

from app.database import Base


class ResourceCandidate(Base):
    """Resources found by the growth agent. Never served to users
    until a human reviews and verified=True on a Resource."""
    __tablename__ = "resource_candidates"

    id = Column(Integer, primary_key=True)
    name = Column(String(255), nullable=False)
    description = Column(String, nullable=True)
    address = Column(String(255), nullable=True)
    city = Column(String(100), nullable=True)
    phone = Column(String(50), nullable=True)
    url = Column(String(500), nullable=True)
    hours = Column(String(255), nullable=True)
    eligibility = Column(String(500), nullable=True)
    service_types = Column(String(500), nullable=True)  # comma-joined, human-editable
    source_url = Column(String(500), nullable=True)
    status = Column(String(20), nullable=False, default="pending", index=True)  # pending | approved | rejected
    reviewer_notes = Column(String(500), nullable=True)
    found_at = Column(DateTime, default=lambda: datetime.now(timezone.utc))
    reviewed_at = Column(DateTime, nullable=True)