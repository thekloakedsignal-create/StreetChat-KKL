"""DB bootstrap: pgvector extension + tables, optional seed import.

Usage:
    python -m scripts.init_db                      # extension + tables only
    python -m scripts.init_db --seed data/seed     # imports every *.json in the dir
    python -m scripts.init_db --seed some_file.json  # or a single file

Embedding rows takes a few minutes the first time (fastembed downloads
the model). Run without --seed first to verify connectivity.
"""
import argparse
import json
import logging
from pathlib import Path

from sqlalchemy import text

from app.database import Base, engine, get_db_ctx
from app.models.resource import Resource
from app.services.retrieval import embed_text

logger = logging.getLogger(__name__)
logging.basicConfig(level=logging.INFO, format="%(levelname)s %(message)s")


def ensure_extension():
    with engine.connect() as conn:
        conn.execute(text("CREATE EXTENSION IF NOT EXISTS vector"))
        conn.commit()
    logger.info("pgvector extension ready")


def ensure_tables():
    Base.metadata.create_all(bind=engine)
    logger.info("tables ready")


def seed_file(db, path: Path) -> tuple[int, int]:
    """Returns (added, skipped)."""
    payload = json.loads(path.read_text(encoding="utf-8"))
    rows = payload.get("resources") if isinstance(payload, dict) else payload
    if not rows:
        logger.warning(f"{path.name}: no resources in file")
        return 0, 0

    added = skipped = 0
    for item in rows:
        name = (item.get("name") or "").strip()
        if not name or db.query(Resource).filter(Resource.name == name).first():
            skipped += 1
            continue

        blob = " — ".join(filter(None, [
            name,
            item.get("description"),
            item.get("city"),
            ", ".join(item.get("service_types") or []),
        ]))
        db.add(Resource(
            name=name,
            description=item.get("description"),
            address=item.get("address"),
            city=item.get("city"),
            phone=item.get("phone"),
            url=item.get("url"),
            hours=item.get("hours"),
            eligibility=item.get("eligibility"),
            service_types=item.get("service_types") or [],
            source_url=item.get("source_url") or item.get("url"),
            verified=True,
            embedding=embed_text(blob),
        ))
        added += 1
        if added % 10 == 0:
            logger.info(f"  seeded {added}…")
    return added, skipped


def seed_from(path: Path):
    files = sorted(path.glob("*.json")) if path.is_dir() else [path]
    if not files:
        logger.warning(f"no seed files at {path}")
        return
    added_total = skipped_total = 0
    with get_db_ctx() as db:
        for f in files:
            logger.info(f"seeding from {f}")
            added, skipped = seed_file(db, f)
            added_total += added
            skipped_total += skipped
    logger.info(f"seed complete: +{added_total}, skipped {skipped_total}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--seed", type=Path, default=None,
                        help="Seed file or directory of seed JSON files")
    args = parser.parse_args()

    ensure_extension()
    ensure_tables()
    if args.seed:
        seed_from(args.seed)