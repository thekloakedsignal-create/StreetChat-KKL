"""Admin: candidate review queue + growth agent trigger.
Guarded by a static API key header (X-Admin-Key), separate from user JWTs.
"""
import logging
from datetime import datetime, timezone

from fastapi import APIRouter, Depends, Header, HTTPException
from sqlalchemy.orm import Session

from app.config import settings
from app.database import get_db
from app.models.candidate import ResourceCandidate
from app.models.resource import Resource
from app.schemas import CandidateOut, ReviewRequest
from app.services.growth_agent import run_growth_agent

logger = logging.getLogger(__name__)
router = APIRouter(prefix="/admin", tags=["admin"])


def require_admin(x_admin_key: str = Header(default="")):
    if not settings.admin_api_key or x_admin_key != settings.admin_api_key:
        raise HTTPException(401, "Invalid admin key")


@router.get("/candidates", response_model=list[CandidateOut], dependencies=[Depends(require_admin)])
def list_candidates(status: str = "pending", db: Session = Depends(get_db)):
    return (
        db.query(ResourceCandidate)
        .filter(ResourceCandidate.status == status)
        .order_by(ResourceCandidate.found_at.desc())
        .limit(200)
        .all()
    )


@router.post("/candidates/{cid}/approve", response_model=CandidateOut, dependencies=[Depends(require_admin)])
def approve(cid: int, req: ReviewRequest, db: Session = Depends(get_db)):
    c = db.query(ResourceCandidate).filter(ResourceCandidate.id == cid).first()
    if not c:
        raise HTTPException(404, "not found")
    c.status = "approved"
    c.reviewer_notes = req.notes
    c.reviewed_at = datetime.now(timezone.utc)

    # Promote to verified Resource
    resource = Resource(
        name=c.name,
        description=c.description,
        address=c.address,
        city=c.city,
        phone=c.phone,
        url=c.url,
        hours=c.hours,
        eligibility=c.eligibility,
        service_types=[t.strip().lower() for t in (c.service_types or "").split(",") if t.strip()],
        source_url=c.source_url,
        verified=True,
    )
    db.add(resource)
    db.commit()
    db.refresh(c)
    logger.info(f"candidate {cid} approved -> resource {resource.id}")
    return c


@router.post("/candidates/{cid}/reject", response_model=CandidateOut, dependencies=[Depends(require_admin)])
def reject(cid: int, req: ReviewRequest, db: Session = Depends(get_db)):
    c = db.query(ResourceCandidate).filter(ResourceCandidate.id == cid).first()
    if not c:
        raise HTTPException(404, "not found")
    c.status = "rejected"
    c.reviewer_notes = req.notes
    c.reviewed_at = datetime.now(timezone.utc)
    db.commit()
    db.refresh(c)
    return c


@router.post("/growth/run", dependencies=[Depends(require_admin)])
def run_growth(db: Session = Depends(get_db)):
    return run_growth_agent(db)