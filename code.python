"""Public resource directory + debug context endpoint. Everything here
is verified-only by construction — candidates live in the admin router.
"""
from fastapi import APIRouter, Depends, Query
from sqlalchemy.orm import Session

from app.database import get_db
from app.models.resource import Resource
from app.schemas import ResourceOut
from app.services.retrieval import get_rag_context

router = APIRouter(prefix="/api/resources", tags=["resources"])


@router.get("", response_model=list[ResourceOut])
def list_resources(
    city: str | None = Query(None),
    service_type: str | None = Query(None),
    db: Session = Depends(get_db),
):
    q = db.query(Resource).filter(Resource.verified.is_(True))
    if city:
        q = q.filter(Resource.city.ilike(f"%{city}%"))
    if service_type:
        # service_types is JSON array; contains() works on Postgres JSON
        q = q.filter(Resource.service_types.contains([service_type.lower()]))
    return q.order_by(Resource.city, Resource.name).limit(200).all()


@router.get("/context")
def rag_context(query: str = Query(...), db: Session = Depends(get_db)):
    """Debug: see exactly what RAG would inject for a given message."""
    return {"query": query, "context": get_rag_context(db, query)}