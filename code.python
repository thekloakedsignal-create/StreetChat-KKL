from functools import lru_cache
from pathlib import Path

PROMPTS_DIR = Path(__file__).resolve().parent.parent / "prompts"


@lru_cache(maxsize=16)
def _load(name: str) -> str:
    path = PROMPTS_DIR / name
    if not path.exists():
        return ""
    return path.read_text(encoding="utf-8").strip()


def client_system_prompt() -> str:
    return _load("client_system.md")


def casemanager_system_prompt() -> str:
    return _load("casemanager_system.md")


def sms_suffix() -> str:
    return _load("suffix_sms.md")


def crisis_suffix() -> str:
    return _load("suffix_crisis.md")