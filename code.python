from datetime import datetime
from typing import Any

from sqlalchemy import JSON, Boolean, DateTime, String, Text
from sqlalchemy.types import TypeDecorator
from sqlalchemy.orm import Mapped, mapped_column

from app.database import Base, utcnow

EMBEDDING_DIM = 384  # BAAI/bge-small-en-v1.5


class PgVectorOrJSON(TypeDecorator):
    """VECTOR(384) on Postgres (pgvector); JSON list everywhere else so
    create_all and tests work on sqlite without the extension."""
    impl = JSON
    cache_ok = True

    def load_dialect_impl(self, dialect: Any) -> Any:
        if dialect.name == "postgresql":
            from pgvector.sqlalchemy import Vector

            return dialect.type_descriptor(Vector(EMBEDDING_DIM))
        return dialect.type_descriptor(JSON())

    def process_bind_param(self, value: Any, dialect: Any) -> Any:
        return value

    def process_result_value(self, value: Any, dialect: Any) -> Any:
        return value


class Resource(Base):
    """User-visible directory rows. verified=True rows only ever surface in chat;
    unverified leads live in ResourceCandidate, not here."""
    __tablename__ = "resources"

    id: Mapped[int] = mapped_column(primary_key=True)
    name: Mapped[str] = mapped_column(String(512), index=True)
    description: Mapped[str | None] = mapped_column(Text, nullable=True)
    address: Mapped[str | None] = mapped_column(String(512), nullable=True)
    city: Mapped[str | None] = mapped_column(String(128), nullable=True, index=True)
    phone: Mapped[str | None] = mapped_column(String(64), nullable=True)
    url: Mapped[str | None] = mapped_column(String(1024), nullable=True)
    hours: Mapped[str | None] = mapped_column(String(256), nullable=True)
    eligibility: Mapped[str | None] = mapped_column(String(512), nullable=True)
    service_types: Mapped[list | None] = mapped_column(JSON, nullable=True)
    source_url: Mapped[str | None] = mapped_column(String(1024), nullable=True)
    # Seed data is curated-verified by default; growth leads never touch this table.
    verified: Mapped[bool] = mapped_column(Boolean, default=True)
    embedding: Mapped[list | None] = mapped_column(PgVectorOrJSON, nullable=True)
    created_at: Mapped[datetime] = mapped_column(DateTime, default=utcnow)