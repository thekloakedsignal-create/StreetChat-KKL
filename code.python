"""Deterministic risk detector. It *flags* risk, it does not *respond to*
risk. Response framing is owned by the LLM (fine-tuned for it). This exists
so the API/UI get a consistent non-LLM signal for rendering and logging —
not so the backend can narrate at the user.
"""
import re

from app.config import settings

# suicide/self-harm: unambiguous crisis
_CRISIS_PATTERNS = [
    r"\bk(?:ill|illing)\s+(?:myself|me)\b", r"\bsuicid",
    r"\bend (?:it|my life|myself)\b", r"\bwanna die\b", r"\bwant to die\b",
    r"\bno way out\b", r"\bend it all\b", r"\b(?:hurt|harm|cut)\s+myself\b",
    r"\boverdose\b", r"\bno reason to (?:live|go on)\b", r"\bbetter off dead\b",
    r"\bkill (?:me|myself)\b", r"\btake my (?:own )?life\b",
]
# partner violence: flagged for the API/UI — not auto-escalated, not lectured
_DV_PATTERNS = [
    r"\b(?:boyfriend|girlfriend|husband|wife|partner)\b[^.]{0,50}\b(?:hits?|beats?|chokes?|hurts?|rapes?|threw)\b",
    r"\b(?:hits?|beats?|chokes?|hurts?|rapes?|threw)\b[^.]{0,50}\b(?:boyfriend|girlfriend|husband|wife|partner)\b",
    r"\bdomestic violen", r"\babusive (?:boyfriend|girlfriend|partner|husband|wife)\b",
]

CRISIS_HOTLINES = [
    "988 — Suicide & Crisis Lifeline, call or text, 24/7",
    "Crisis Text Line — text HOME to 741741",
]


def _matches_any(text: str, patterns: list[str]) -> list[str]:
    return [p for p in patterns if re.search(p, text, re.IGNORECASE)]


def score_risk(message: str) -> dict:
    crisis_hits = _matches_any(message, _CRISIS_PATTERNS)
    dv_hits = _matches_any(message, _DV_PATTERNS)

    score = 0.0
    if crisis_hits:
        score += 70 + 15 * len(crisis_hits)
    if dv_hits:
        score += 30 + 5 * len(dv_hits)

    crisis_triggered = score >= settings.risk_threshold
    dv_flagged = bool(dv_hits)

    tags = []
    if crisis_triggered:
        tags.append("crisis")
    if dv_flagged:
        tags.append("dv")

    return {
        "score": min(score, 100),
        "crisis_triggered": crisis_triggered,
        "dv_flagged": dv_flagged,
        "hotline": "; ".join(CRISIS_HOTLINES) if crisis_triggered else None,
        "tags": tags,
        "crisis_hits": crisis_hits,
        "dv_hits": dv_hits,
    }