"""Cached reads from prompts/*.md. Prompts are human-edited product copy, so a
missing file degrades to '' — the app runs and the model just gets less context.
Nothing in the codebase loads suffix_crisis.md; crisis handling is flags, not lectures.
"""
from functools import lru_cache
from pathlib import Path

_PROMPTS_DIR = Path(__file__).resolve().parent.parent / "prompts"


@lru_cache(maxsize=32)
def _read(name: str) -> str:
    try:
        return (_PROMPTS_DIR / name).read_text(encoding="utf-8").strip()
    except OSError:
        return ""


def _first(*names: str) -> str:
    # tolerate reasonable filename drift in the prompts/ directory
    for name in names:
        text = _read(name)
        if text:
            return text
    return ""


def client_system_prompt() -> str:
    return _first("persona_client.md", "client.md", "client_persona.md")


def casemanager_system_prompt() -> str:
    return _first("persona_casemanager.md", "casemanager.md", "case_manager.md")


def sms_suffix() -> str:
    return _first("suffix_sms.md", "sms_suffix.md", "sms.md")