"""Hybrid RAG over verified resources: pgvector dense + Postgres FTS,
fused with Reciprocal Rank Fusion. Only verified=True rows are ever
visible here — candidates live in a different table entirely.
"""
import logging
from functools import lru_cache
from typing import Optional

from sqlalchemy import cast, func, or_, String
from sqlalchemy.orm import Session

from app.config import settings
from app.models.resource import Resource

logger = logging.getLogger(__name__)

TOP_K = 6
RRF_K = 60

_embedder = None


def _get_embedder():
    global _embedder
    if _embedder is None and settings.embeddings_enabled:
        from fastembed import TextEmbedding
        _embedder = TextEmbedding("BAAI/bge-small-en-v1.5")
    return _embedder


def embed_text(text: str) -> Optional[list[float]]:
    emb = _get_embedder()
    if emb is None:
        return None
    try:
        return list(emb.embed([text]))[0].tolist()
    except Exception as e:
        logger.warning(f"embed failed: {e}")
        return None


def hybrid_search(db: Session, query: str, top_k: int = TOP_K) -> list[Resource]:
    base = db.query(Resource).filter(Resource.verified.is_(True))

    # Dense side (may be empty if embeddings disabled)
    dense: list[Resource] = []
    vec = embed_text(query)
    if vec is not None:
        dense = (
            base.filter(Resource.embedding.isnot(None))
            .order_by(Resource.embedding.cosine_distance(vec))
            .limit(top_k * 2)
            .all()
        )

    # Keyword side: trigram-ish ILIKE over name/description/service types
    words = [w for w in query.lower().split() if len(w) > 3][:6]
    if not words:
        words = [query.lower()]
    conds = []
    for w in words:
        like = f"%{w}%"
        conds.append(Resource.name.ilike(like))
        conds.append(Resource.description.ilike(like))
        conds.append(Resource.city.ilike(like))
        conds.append(cast(Resource.service_types, String).ilike(like))
    keyword = base.filter(or_(*conds)).limit(top_k * 2).all()

    # RRF fuse
    scores: dict[int, float] = {}
    by_id: dict[int, Resource] = {}
    for rank, r in enumerate(dense):
        scores[r.id] = scores.get(r.id, 0.0) + 1.0 / (RRF_K + rank + 1)
        by_id[r.id] = r
    for rank, r in enumerate(keyword):
        scores[r.id] = scores.get(r.id, 0.0) + 1.0 / (RRF_K + rank + 1)
        by_id[r.id] = r

    ranked_ids = sorted(scores, key=scores.get, reverse=True)[:top_k]
    return [by_id[i] for i in ranked_ids]


def format_context(resources: list[Resource]) -> str:
    if not resources:
        return ""
    lines = ["VERIFIED LOCAL RESOURCES (cite these by name, phone, and URL):"]
    for r in resources:
        line = f"• {r.name}"
        if r.city:
            line += f" ({r.city})"
        if r.phone:
            line += f" — {r.phone}"
        if r.hours:
            line += f" — {r.hours}"
        lines.append(line)
        if r.address:
            lines.append(f"  Address: {r.address}")
        if r.eligibility:
            lines.append(f"  Eligibility: {r.eligibility[:200]}")
        if r.url:
            lines.append(f"  {r.url}")
    return "\n".join(lines)


def get_rag_context(db: Session, query: str, top_k: int = TOP_K) -> str:
    try:
        return format_context(hybrid_search(db, query, top_k))
    except Exception as e:
        logger.warning(f"RAG retrieval failed: {e}")
        return ""