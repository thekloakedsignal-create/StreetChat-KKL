from datetime import datetime, timezone

from sqlalchemy import Column, Integer, String, DateTime, ForeignKey, Index

from app.database import Base


class Conversation(Base):
    """Rolling short-term message history for open conversations.
    Capped per user+channel by the orchestrator — journals are the
    long-term memory, this is just the live window."""
    __tablename__ = "conversations"

    id = Column(Integer, primary_key=True)
    user_id = Column(Integer, ForeignKey("users.id"), nullable=True)  # null = anonymous pre-login SMS
    channel = Column(String(20), nullable=False)  # "sms" | "web"
    channel_identifier = Column(String(50), nullable=True)  # phone number or session key
    role = Column(String(10), nullable=False)  # "user" | "assistant"
    content = Column(String, nullable=False)
    created_at = Column(DateTime, default=lambda: datetime.now(timezone.utc))

    __table_args__ = (
        Index("ix_conv_channel_ident_created", "channel", "channel_identifier", "created_at"),
    )