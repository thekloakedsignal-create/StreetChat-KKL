"""Web chat endpoints. Anonymous requests get RAG + crisis support but
no memory; logged-in requests get the full journal pipeline.
"""
import base64
import logging

from fastapi import APIRouter, Depends
from sqlalchemy.orm import Session

from app.database import get_db
from app.deps import get_current_user_optional
from app.models.user import User
from app.schemas import ChatRequest, ChatImageRequest
from app.services.chat_orchestrator import process_message

logger = logging.getLogger(__name__)
router = APIRouter(prefix="/api", tags=["chat"])


@router.get("/health")
def health():
    return {"status": "ok", "service": "streetchat"}


@router.post("/chat")
async def chat(
    req: ChatRequest,
    db: Session = Depends(get_db),
    user: User | None = Depends(get_current_user_optional),
):
    anon_key = req.anonymous_id or "anon:web"
    result = await process_message(
        db=db,
        message=req.message,
        channel="web",
        channel_identifier=anon_key,
        user=user,
    )
    return result


@router.post("/chat/image")
async def chat_image(
    req: ChatImageRequest,
    db: Session = Depends(get_db),
    user: User | None = Depends(get_current_user_optional),
):
    try:
        base64.b64decode(req.image_base64, validate=True)
    except Exception:
        return {"reply": "That image didn't upload right — try again?", "crisis": False}

    anon_key = req.anonymous_id or "anon:web"
    result = await process_message(
        db=db,
        message=req.message,
        channel="web",
        channel_identifier=anon_key,
        user=user,
        images=[{"data": req.image_base64, "media_type": req.media_type}],
    )
    return result